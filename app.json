{
  "expo": {
    "name": "33Bayan",
    "slug": "33bayan",
    "version": "1.11.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "bayan33",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.mostafa.bayan33",
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "name": "33Bayan",
      "shortName": "33Bayan",
      "lang": "fa",
      "themeColor": "#FFFFFF",
      "backgroundColor": "#FFFFFF"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "33Bayan برای تمرین تلفظ، صدای شما را ضبط می‌کند تا کنار صدای نمونه پخش شود.",
          "recordAudioAndroid": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "15d7211a-c080-4c60-832b-60d638c34833"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/15d7211a-c080-4c60-832b-60d638c34833"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
